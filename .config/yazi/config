[manager]
show_hidden = true
sort_by = "natural"
sort_sensitive = false
sort_dir_first = true
linemode = "size"

[preview]
wrap = "yes"
tab_size = 2
max_width = 600
max_height = 900

[opener]
edit = [
    { run = 'nano "$@"', block = true, for = "unix" }
]

[open]
rules = [
    { mime = "text/*", use = "edit" },
]
